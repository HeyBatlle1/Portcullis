# Every variable the server reads. Secrets stay blank here; set them in the
# environment (Render's dashboard in production). See crates/mcp/src/main.rs.

# PayPal sandbox: the account Portcullis pays from
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: that account's email, so the vendor's invoices are addressed to it
PAYPAL_PAYER_EMAIL=

# Optional: the vendor's own sandbox app; siege bills become PayPal invoices
PAYPAL_VENDOR_CLIENT_ID=
PAYPAL_VENDOR_CLIENT_SECRET=

# Agents: name:sha256 pairs from `portcullis mint-token <name>`
PORTCULLIS_AGENT_TOKENS=
# Public hostnames, comma separated
PORTCULLIS_ALLOWED_HOSTS=localhost
PORT=8787

# Models (OpenRouter). Without a key the console and siege agents are off.
OPENROUTER_API_KEY=
PORTCULLIS_DEMO_MODELS=
PORTCULLIS_SIEGE_MODELS=
PORTCULLIS_STUDIO_MODELS=

# Limits (defaults shown)
PORTCULLIS_DEMO_DAILY_RUNS=30
PORTCULLIS_DEMO_PER_VISITOR=5
PORTCULLIS_SIEGE_DAILY=15
PORTCULLIS_SIEGE_PER_VISITOR=3
PORTCULLIS_STUDIO_DAILY_CALLS=400
PORTCULLIS_STUDIO_PER_VISITOR=60

# Audit desk
AG_STUDIO_LICENSE=

# Demo inboxes, comma separated; the first is the default
PORTCULLIS_SCENARIOS=

# Only for the live sandbox test (cargo test -p portcullis-executor --test sandbox_live)
PAYPAL_SANDBOX_RECEIVER=
